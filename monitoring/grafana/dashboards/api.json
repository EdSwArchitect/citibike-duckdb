      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Archive downloads",
      "type": "link",
      "url": "/d/citibike-downloads",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "JVM",
      "type": "link",
      "url": "/d/citibike-jvm",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Monthly ingestion",
      "type": "link",
      "url": "/d/citibike-ingestion",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "label": "Application instance",
        "datasource": {
          "type": "prometheus",
          "uid": "citibike-prometheus"
        },
        "query": "label_values(up{job=\"citibike\"}, instance)",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "options": []
      }
    ]
  }
}
