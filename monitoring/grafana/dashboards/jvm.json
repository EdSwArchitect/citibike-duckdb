      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unknown / no samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "GC pauses / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "citibike-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(jvm_gc_pause_seconds_count{job=\"citibike\",instance=\"$instance\"}[$__rate_interval]))) and on() (up{job=\"citibike\",instance=\"$instance\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Unknown / no samples",
