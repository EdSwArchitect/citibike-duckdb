{
  "uid": "citibike-jvm",
  "title": "Citi Bike / JVM and process",
  "description": "CPU values are fractions; memory panels reflect JVM-managed pools rather than total DuckDB native memory. GC rates need multiple scrapes.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "citibike"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Prometheus scrape",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "citibike-prometheus"
      },
      "description": "Scrape reachability only; not analytics readiness.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"citibike\",instance=\"$instance\"}",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unreachable",
                  "color": "red"
                },
                "1": {
                  "text": "Reachable",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Analytics readiness",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "citibike-prometheus"
      },
      "description": "One bounded DuckDB readiness probe per metrics scrape; independent of downloader status.",
      "targets": [
        {
          "refId": "A",
          "expr": "citibike_analytics_ready{job=\"citibike\",instance=\"$instance\"} and on(job,instance) (up{job=\"citibike\",instance=\"$instance\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown / no samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not ready",
                  "color": "red"
                },
                "1": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "JVM heap used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "citibike-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(jvm_memory_used_bytes{job=\"citibike\",instance=\"$instance\",area=\"heap\"})) and on() (up{job=\"citibike\",instance=\"$instance\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown / no samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "JVM non-heap used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "citibike-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(jvm_memory_used_bytes{job=\"citibike\",instance=\"$instance\",area=\"nonheap\"})) and on() (up{job=\"citibike\",instance=\"$instance\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown / no samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "JVM heap max",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "citibike-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(jvm_memory_max_bytes{job=\"citibike\",instance=\"$instance\",area=\"heap\"} > 0)) and on() (up{job=\"citibike\",instance=\"$instance\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown / no samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Process CPU",
      "type": "timeseries",
      "datasource": {
