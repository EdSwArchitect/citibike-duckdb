      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(process_cpu_usage{job=\"citibike\",instance=\"$instance\"}) and on() (up{job=\"citibike\",instance=\"$instance\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unknown / no samples",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "System CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "citibike-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(system_cpu_usage{job=\"citibike\",instance=\"$instance\"}) and on() (up{job=\"citibike\",instance=\"$instance\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": false
