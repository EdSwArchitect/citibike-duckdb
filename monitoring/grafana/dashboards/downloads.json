    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "label": "Application instance",
        "datasource": {
          "type": "prometheus",
          "uid": "citibike-prometheus"
        },
        "query": "label_values(up{job=\"citibike\"}, instance)",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "options": []
      }
    ]
  }
}
